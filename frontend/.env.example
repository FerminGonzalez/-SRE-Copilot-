# SRE Copilot · Frontend
# -----------------------------------------------------------------------------
# Única variable que necesita el dashboard. Debe apuntar al prefijo /api del
# copilot (Azure Function), nunca a credenciales ni a endpoints de producción.
#
# Copia este fichero a `.env.local` (gitignored) y ajústalo si hace falta.
VITE_COPILOT_URL=http://localhost:7071/api
