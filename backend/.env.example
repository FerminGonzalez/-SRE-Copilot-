# SRE Copilot - backend
# Copia este fichero a `.env` y ajusta los valores.
# NO subas el `.env` al repositorio: los secretos van por variable de entorno o Key Vault.

# --- Servidor ---
# Puerto HTTP del backend (ejemplo: 8080).
PORT=8080
# Entorno de ejecucion (ejemplo: local, dev, prod).
ENVIRONMENT=local
# Nivel minimo de log: debug | info | warn | error (ejemplo: info).
LOG_LEVEL=info
# Nombre del servicio tal y como aparece en Application Insights (ejemplo: sre-copilot-backend).
OTEL_SERVICE_NAME=sre-copilot-backend
# Version del servicio (ejemplo: 1.0.0).
SERVICE_VERSION=1.0.0

# --- Modo de fallo de la demo ---
# none | database | misconfig | dependency (ejemplo: none).
FAILURE_MODE=none

# --- Base de datos ---
# Ejemplo DELIBERADAMENTE mal configurado (el mismo que despliega infrastructure/main.tf):
# el host no existe, por eso el modo "database" falla por timeout. No lo "arregles".
DATABASE_URL=postgres://wrong-host:5432/mydb

# --- Application Insights ---
# Connection string de Application Insights (lo inyecta Terraform como app setting).
# Si se deja vacia, el backend exporta los spans por consola.
APPLICATIONINSIGHTS_CONNECTION_STRING=
# Desactiva la telemetria por completo (util en tests): true | false (ejemplo: false).
OTEL_SDK_DISABLED=false
