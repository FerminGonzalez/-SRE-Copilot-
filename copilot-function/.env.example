# ============================================
# SRE Copilot · copilot-function
# Copia a `.env` y rellena los valores. NUNCA subas el `.env` al repositorio.
# Ningún valor de este fichero es real: son ejemplos marcados.
# ============================================

# ---------- LLM (CONTRACTS.md §9) ----------
# Proveedor: azure-openai | anthropic | mock   (mock = modo offline determinista)
LLM_PROVIDER=mock
AZURE_OPENAI_ENDPOINT=https://<recurso>.openai.azure.com
AZURE_OPENAI_API_KEY=<azure-openai-api-key>
AZURE_OPENAI_DEPLOYMENT=<deployment-name>
ANTHROPIC_API_KEY=<anthropic-api-key>

# ---------- GitHub (CONTRACTS.md §3, §9) ----------
GITHUB_TOKEN=<github-token>
GITHUB_REPO=<owner>/<repo>

# ---------- Dynatrace (CONTRACTS.md §3, §9) ----------
DYNAATRACE_API_URL=https://<env>.live.dynatrace.com
DYNAATRACE_API_TOKEN=<dynatrace-api-token>

# ---------- Azure Monitor / Log Analytics (KQL) ----------
AZURE_MONITOR_WORKSPACE_ID=<workspace-id>
AZURE_MONITOR_API_KEY=<workspace-primary-key>

# ---------- Azure AI Search (memoria RAG) ----------
# Si faltan AZURE_SEARCH_ENDPOINT / AZURE_SEARCH_INDEX se usa el fallback local.
AZURE_SEARCH_ENDPOINT=https://<recurso>.search.windows.net
AZURE_SEARCH_INDEX=<index-name>
AZURE_SEARCH_API_KEY=<azure-search-api-key>

# ---------- Observabilidad ----------
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<key>;IngestionEndpoint=https://<region>.inquest.azure.com/

# ---------- Motor de diagnóstico ----------
DIAGNOSTIC_DEFAULT_WINDOW_MINUTES=15
DIAGNOSTIC_MAX_ITERATIONS=6
DIAGNOSTIC_MAX_TOOL_CALLS=12
DIAGNOSTIC_DEFAULT_SERVICE=<service-name>
DIAGNOSTIC_DEFAULT_ENVIRONMENT=dev

# ---------- Memoria de incidentes (RAG) ----------
RAG_ENABLED=true
RAG_BACKEND=auto
RAG_TOP_K=5

# ---------- Barrido periódico (timer trigger) ----------
SWEEP_SERVICES=<service-a>,<service-b>
SWEEP_WINDOW_MINUTES=30

# ---------- Alertas (queue trigger) ----------
ALERT_QUEUE_NAME=sre-copilot-alerts
